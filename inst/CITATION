# Citation entry for cropOrchestra.
# Title, author and version come from DESCRIPTION (via `meta`).
# The year is taken from the Date field when present.

year <- if (!is.null(meta$Date)) sub("-.*", "", meta$Date) else "2026"

bibentry(
  bibtype = "Manual",
  title = paste0(meta$Package, ": ", meta$Title),
  author = eval(parse(text = meta$`Authors@R`), envir = asNamespace("utils")),
  year = year,
  note = paste("R package version", meta$Version),
  url = "https://github.com/max578/cropOrchestra"
)
